# Send only the native distribution and the container definitions to the daemon.
**
!Dockerfile
!docker-compose.yml
!build/
!build/container/
!build/container/Numera Browser/
!build/container/Numera Browser/engine/
!build/container/Numera Browser/engine/**

# Never admit application state or development credentials within a bundle.
.git
.ai
.ignoreme
**/.ignoreme
secrets.md
.venv
graphify-out
**/.git
**/.ai
**/.agents
**/.codex
**/.claude
**/.kiro
**/.cursor
**/.env
**/.env.*
**/data
**/logs
**/user-data
**/vault-migration.json
**/vault-rotation.json
**/__pycache__
**/*.pyc
