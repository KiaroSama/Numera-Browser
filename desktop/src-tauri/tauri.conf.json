{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Numera Browser",
  "version": "0.36.0",
  "identifier": "com.numera.desktop",
  "build": {
    "frontendDist": "../../dashboard/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Numera Browser",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "KiaroSama",
    "copyright": "KiaroSama",
    "category": "DeveloperTool",
    "shortDescription": "Local-first browser-profile manager for authorized testing and automation"
  }
}
