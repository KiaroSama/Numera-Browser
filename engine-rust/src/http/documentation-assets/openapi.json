{"openapi":"3.1.0","info":{"title":"Numera Browser API","version":"0.36.0"},"paths":{"/api/ready":{"get":{"summary":"Ready","description":"Is the engine up, and does it want a token? Public by design.\n\nIt names the product and the version and says whether auth is on. That\nis what a launcher needs and it is not worth protecting: anything that\ncan reach this port can already see a socket answering on it. Nothing\nabout the user's profiles, proxies or tokens is here.","operationId":"ready_api_ready_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/health":{"get":{"summary":"Health","operationId":"health_api_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/engines":{"get":{"summary":"Engines","operationId":"engines_api_engines_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/config":{"get":{"summary":"Get Config","operationId":"get_config_api_config_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"put":{"summary":"Set Config","operationId":"set_config_api_config_put","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Cfg"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/extensions/install":{"post":{"summary":"Install Extension","description":"Download a Web Store extension and unpack it into the data directory.\n\nChromium cannot install from the store with automation enabled, so the\ncrx is fetched from Google's own update endpoint and unpacked - the same\nthing every commercial anti-detect browser does behind a 'paste a link'\nbox.","operationId":"install_extension_api_extensions_install_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/extensions/installed":{"get":{"summary":"Installed Extensions","description":"Every folder the UI has to draw a row for, named and with its icon.\n\nNot only the ones fetched from the store: a folder the user unpacked by\nhand has a manifest too, and a row showing a bare path tells them nothing\nabout which extension it is.","operationId":"installed_extensions_api_extensions_installed_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/extensions/icon":{"get":{"summary":"Extension Icon","description":"Serve one extension's own icon.\n\nReading an arbitrary path off the filesystem on request would be a hole,\nso the folder has to be one the engine already knows: installed from the\nstore, or listed in the default set. Anything else is refused rather than\nread.","operationId":"extension_icon_api_extensions_icon_get","parameters":[{"name":"path","in":"query","required":true,"schema":{"type":"string","title":"Path"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/folders":{"post":{"summary":"Create Folder","operationId":"create_folder_api_folders_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/folders/rename":{"post":{"summary":"Rename Folder","operationId":"rename_folder_api_folders_rename_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/folders/delete":{"post":{"summary":"Delete Folder","operationId":"delete_folder_api_folders_delete_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/tokens":{"get":{"summary":"List Tokens","description":"Never the token itself - only what it is called and when it was used.\n\n`envToken` says whether `NUMERA_API_TOKEN` is also in play, because a\nuser who revokes every named token and still gets 401s needs to know\nthe env var is the reason.","operationId":"list_tokens_api_tokens_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Create Token","description":"Mint one. The value comes back here and is never retrievable again.","operationId":"create_token_api_tokens_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/tokens/{tid}":{"delete":{"summary":"Revoke Token","description":"Remove one token, unless it is the only way into this server.\n\nRemoving the last credential used to reopen the API to everyone, which\nis the opposite of what the person clicking \"revoke\" is asking for.\nThe environment token counts as an alternative, because it still\nauthenticates after this one is gone.","operationId":"revoke_token_api_tokens__tid__delete","parameters":[{"name":"tid","in":"path","required":true,"schema":{"type":"string","title":"Tid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles":{"get":{"summary":"List Profiles","operationId":"list_profiles_api_profiles_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Create Profile","operationId":"create_profile_api_profiles_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Profile"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}":{"put":{"summary":"Update Profile","operationId":"update_profile_api_profiles__pid__put","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Profile"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Profile","operationId":"delete_profile_api_profiles__pid__delete","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/delete":{"post":{"summary":"Delete Profiles","description":"Delete many profiles in one call.\n\nThe dashboard looped `DELETE /api/profiles/{id}` per selection, so\nremoving 200 profiles was 200 round trips - the odd one out beside\n`/batch` and `/bulk`, which are both batched.\n\nEach delete keeps its own semantics: existence checked before anything\nis destroyed, one owner for both copies, session directory last. A\nprofile that fails is reported rather than aborting the rest, because a\nhalf-finished delete of an explicit selection is worse than a partial\none the caller can see and retry.","operationId":"delete_profiles_api_profiles_delete_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/batch":{"post":{"summary":"Batch Create","description":"Save many dashboard profiles in one request (bulk create at scale).\n\nThe dashboard generates coherent profiles client-side and posts them in\nchunks; this just persists them, assigning each a fresh unique id.","operationId":"batch_create_api_profiles_batch_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/bulk":{"post":{"summary":"Bulk Update","description":"Apply one patch to many profiles — the dashboard's multi-select edit.","operationId":"bulk_update_api_profiles_bulk_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/fingerprint/validate":{"post":{"summary":"Validate Fingerprint","operationId":"validate_fingerprint_api_fingerprint_validate_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Profile"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/import":{"post":{"summary":"Import Profiles","description":"Import profiles, from a Numera export or from a vendor's.\n\nTwo formats, read two different ways, because they are two different\nthings. A vendor file goes through the tolerant importer: it is\nsomebody else's schema, so fields are looked for under every name they\nare known by and whatever is missing is generated coherently.\n\nNumera's own export is *configuration this install wrote*, and running\nit through those heuristics was destruction dressed as tolerance -\n`profile_from_export` reads no `seed`, no per-signal mode, no startup\nURLs, extensions, launch arguments, bookmarks, DNS or clear-on-start\nlist, and reads `folder` only to append it to the tags. A user's own\nfile came back as a different device in the wrong folder, reported as a\nsuccessful import. So it is versioned, and read field for field.\n\nWhat is deliberately not preserved: the id and the store's own\nbookkeeping. The id is what the session directory, proxy assignments\nand revisions hang off, and a file cannot claim one.\n\nWhat cannot be preserved is said out loud rather than implied: a file\nfrom before the format was versioned is refused by name, and a proxy\npassword the vault was holding when the file was written comes back as\nan issue on that profile, not as a silent blank.\n\nThis is configuration, not a session backup: the browser profile\ndirectory - cookies, logins, local storage - is not in this file.","operationId":"import_profiles_api_profiles_import_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/collisions":{"get":{"summary":"Profiles Collisions","description":"Profiles that share a fingerprint — a cross-account linkage risk.\n\nConverts each stored dashboard profile to its engine fingerprint and\ngroups the ones that look like the same device.","operationId":"profiles_collisions_api_profiles_collisions_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/profiles/health":{"get":{"summary":"Profiles Health","description":"One row per profile with everything the Health page needs, computed\ncheaply. Coherence and proxy are read straight from the stored profile;\nthe trust grade is the *cached* one from the last trust/align run (a live\ntrust check opens a real browser, too heavy to do for the whole grid).","operationId":"profiles_health_api_profiles_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/profiles/{pid}/launch":{"post":{"summary":"Launch Profile","description":"Open the profile in its own browser process.\n\nPass ``{\"headless\": true}`` (or set ``headless_launch`` in the config)\non a machine with no display, where a windowed launch cannot start at\nall. The browser stays up until POST /stop either way.","operationId":"launch_profile_api_profiles__pid__launch_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"type":"object","additionalProperties":true},{"type":"null"}],"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/stop":{"post":{"summary":"Stop Profile","description":"End the browser this server started for the profile.\n\n200 used to be unconditional, which made it a lie for the one case that\nmatters: `stop_session` can only terminate a local child, so when the\nlease is held by another server, a desktop or a CLI, nothing was\nstopped and the browser is still open - and the dashboard showed the\nprofile as stopped anyway. There is no cross-process stop, so the\nanswer is the conflict rather than a success nobody produced.","operationId":"stop_profile_api_profiles__pid__stop_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/cookies":{"get":{"summary":"Export Cookies","operationId":"export_cookies_api_profiles__pid__cookies_get","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"post":{"summary":"Import Cookies","operationId":"import_cookies_api_profiles__pid__cookies_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/proxy-test":{"post":{"summary":"Proxy Test","operationId":"proxy_test_api_profiles__pid__proxy_test_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/trust":{"post":{"summary":"Trust","operationId":"trust_api_profiles__pid__trust_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/tls":{"post":{"summary":"Tls","operationId":"tls_api_profiles__pid__tls_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/dns":{"post":{"summary":"Dns","operationId":"dns_api_profiles__pid__dns_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/attach":{"post":{"summary":"Attach Profile","description":"Open the profile with a Chrome DevTools endpoint your own automation\ncan drive, and return the connection details.\n\nThe browser stays open — attached and 'running' — until it's stopped\n(POST /stop), exactly like a launch. The attach itself runs as a\nsubprocess that owns the window; we read the DevTools endpoint's own\n/json/version over HTTP to hand back the WebSocket URL. Pass\n``{\"headless\": true}`` to attach without a visible window.","operationId":"attach_profile_api_profiles__pid__attach_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"type":"object","additionalProperties":true},{"type":"null"}],"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/warmup":{"post":{"summary":"Warmup","operationId":"warmup_api_profiles__pid__warmup_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"requestBody":{"content":{"application/json":{"schema":{"anyOf":[{"type":"object","additionalProperties":true},{"type":"null"}],"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/profiles/{pid}/align":{"post":{"summary":"Align","description":"Auto-adjust: rewrite the profile to match what its browser presents,\nthen write the aligned values back so the dashboard profile stays put.","operationId":"align_api_profiles__pid__align_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies":{"get":{"summary":"List Proxies","operationId":"list_proxies_api_proxies_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Add Proxies","operationId":"add_proxies_api_proxies_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/{pid}":{"put":{"summary":"Edit Proxy","description":"Change one proxy in place.\n\nEditing rather than delete-and-reimport matters because the id is what\nprofiles and the status history hang off; recreating it would lose the\nlast check result and orphan nothing visibly.","operationId":"edit_proxy_api_proxies__pid__put","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Proxy","operationId":"delete_proxy_api_proxies__pid__delete","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/export":{"post":{"summary":"Export Proxies","description":"Render proxies back to importable lines.\n\nServer-side on purpose. The line format is the parser's exact inverse and\nthere is a round-trip test holding the two together; a second\nimplementation in the browser would drift from it silently, and the first\nsign would be an export that no longer imports.","operationId":"export_proxies_api_proxies_export_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/delete":{"post":{"summary":"Delete Proxies","description":"Delete several at once. Ids that are already gone are not an error.","operationId":"delete_proxies_api_proxies_delete_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/test":{"post":{"summary":"Test Proxies","description":"Health-check several proxies in one call.\n\nConcurrently: a serial sweep of a 40-proxy pool at ~1s each is a minute\nof staring at a spinner, and these are independent network calls.","operationId":"test_proxies_api_proxies_test_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/{pid}/test":{"post":{"summary":"Test Proxy","operationId":"test_proxy_api_proxies__pid__test_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/{pid}/rotate":{"post":{"summary":"Rotate Proxy","description":"Ask a rotating proxy for a new exit IP and record what came back.","operationId":"rotate_proxy_api_proxies__pid__rotate_post","parameters":[{"name":"pid","in":"path","required":true,"schema":{"type":"string","title":"Pid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/rotate":{"post":{"summary":"Rotate Proxies","description":"Rotate several. Serial on purpose: these hit one provider's control\nplane, and firing eight at once is how a pool gets rate-limited.","operationId":"rotate_proxies_api_proxies_rotate_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/archive":{"post":{"summary":"Archive Proxies","description":"Retire proxies without deleting them.\n\nDelete loses which profiles used a proxy and why it was dropped; archive\nkeeps the row and its last check, and only takes it out of assignment.","operationId":"archive_proxies_api_proxies_archive_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/proxies/assign":{"post":{"summary":"Assign Proxies","description":"Assign pool proxies across profiles, round-robin, aligning each\nprofile's locale/timezone to its proxy country.","operationId":"assign_proxies_api_proxies_assign_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/schedules":{"get":{"summary":"List Schedules","operationId":"list_schedules_api_schedules_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Add Schedule","operationId":"add_schedule_api_schedules_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/schedules/{sid}":{"put":{"summary":"Update Schedule","operationId":"update_schedule_api_schedules__sid__put","parameters":[{"name":"sid","in":"path","required":true,"schema":{"type":"string","title":"Sid"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Schedule","operationId":"delete_schedule_api_schedules__sid__delete","parameters":[{"name":"sid","in":"path","required":true,"schema":{"type":"string","title":"Sid"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}