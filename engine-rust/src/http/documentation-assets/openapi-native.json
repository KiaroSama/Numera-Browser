{
  "paths": {
    "/api/profiles/{id}/cookies/export": {
      "get": {
        "summary": "Export cookie content",
        "description": "Return JSON or Netscape content with a suggested filename. Requires an idle profile and never writes a caller-chosen server file.",
        "operationId": "native_cookie_export",
        "security": [
          {},
          {
            "NativeApiBearer": []
          },
          {
            "NativeApiHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NativeCookieExport"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/NativeError400"
          },
          "401": {
            "$ref": "#/components/responses/NativeError401"
          },
          "404": {
            "$ref": "#/components/responses/NativeError404"
          },
          "409": {
            "$ref": "#/components/responses/NativeError409"
          },
          "500": {
            "$ref": "#/components/responses/NativeError500"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/NativePortableId"
            }
          },
          {
            "name": "format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "netscape"
              ],
              "default": "json"
            }
          }
        ]
      }
    },
